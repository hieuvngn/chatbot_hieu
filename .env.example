# CourseMate RAG — Environment variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is loaded automatically by rag_core/config.py:load_config() via python-dotenv.
# Never commit .env with a real key.

# --- Required ---
# OpenRouter API key — get one at https://openrouter.ai/keys
# Used for embeddings, generation, CRAG judge, answer check, and session rewrite.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional (defaults shown) ---
# LLM for generation / judge / checker / rewrite
RAG_LLM_MODEL=dots-studio/dots-3-note-preview:free
# Embedding model (OpenRouter, 2048-dim)
RAG_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
# Embedding vector dimension — must match the embedding model
RAG_EMBED_DIM=2048
# Data directory containing courses.json / documents.json / app.db
RAG_DATA_DIR=./data
# OpenRouter OpenAI-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
